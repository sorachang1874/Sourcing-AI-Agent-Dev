{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.grok.adaptive_recall_wave.effective_prompt_policy.v1.schema.json",
  "title": "Adaptive Grok recall-wave approved effective prompt policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_version",
    "policy_id",
    "owner",
    "allowed_discovery_dimensions",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "x.grok.adaptive_recall_wave.effective_prompt_policy.v1"
    },
    "binding_version": {
      "const": "adaptive-effective-prompt-entry-semantics-v1"
    },
    "policy_id": {
      "const": "adaptive_base_discovery_effective_prompts.v1"
    },
    "owner": {
      "const": "x_first_adaptive_wave_operator"
    },
    "allowed_discovery_dimensions": {
      "const": [
        "target_lab_affiliation",
        "professional_role_or_function",
        "public_research_evidence",
        "pretraining_relevance"
      ]
    },
    "entries": {
      "description": "Append-only registry rows. Durable grants and runs bind only the selected row plus immutable owner semantics, so unrelated additive rows do not invalidate replay.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_entry_id",
          "target",
          "source_prompt_sha256",
          "authority"
        ],
        "dependentRequired": {
          "session_query_policy_id": [
            "session_query_policy_sha256"
          ],
          "session_query_policy_sha256": [
            "session_query_policy_id"
          ],
          "prior_input_policy_id": [
            "prior_input_policy_sha256"
          ],
          "prior_input_policy_sha256": [
            "prior_input_policy_id"
          ],
          "official_account_handles": [
            "session_query_policy_id",
            "session_query_policy_sha256"
          ]
        },
        "properties": {
          "policy_entry_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lab_id",
              "research_focus_id",
              "scope"
            ],
            "properties": {
              "lab_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
              },
              "research_focus_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            }
          },
          "source_prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "authority": {
            "enum": [
              "fixture_only",
              "live_authorized"
            ]
          },
          "session_query_policy_id": {
            "enum": [
              "mixed_discovery_hydration_v1",
              "discovery_only_no_person_hydration_v1",
              "discovery_only_official_accounts_no_person_hydration_v2"
            ]
          },
          "session_query_policy_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "prior_input_policy_id": {
            "enum": [
              "require_empty_prior_waves_v1"
            ]
          },
          "prior_input_policy_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "official_account_handles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,15}$"
            }
          }
        }
      }
    }
  }
}
