  "$id": "https://contracts.invalid/x.region_experience.classification.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "evidence_decisions": {
