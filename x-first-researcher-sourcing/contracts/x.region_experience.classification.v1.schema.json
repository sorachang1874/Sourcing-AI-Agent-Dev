      "const": "x.region_experience.classification.v1"
    },
    "subject_platform_user_id": {
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]{3,32}$",
      "type": "string"
    },
    "subject_ref": {
      "maxLength": 31,
      "minLength": 31,
      "pattern": "^pp_x_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    }
