{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.grok.adaptive_recall_wave.deletion_receipt.v1.schema.json",
  "title": "Adaptive Grok recall-wave deletion receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_sha256",
    "operator_receipt_sha256",
    "deletion_journal_sha256",
    "deleted_at",
    "state"
  ],
  "properties": {
    "schema_version": {"const": "x.grok.adaptive_recall_wave.deletion_receipt.v1"},
    "run_id": {"type": "string", "pattern": "^grok_wave_(fixture|live)_[0-9a-f]{32}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deletion_journal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deleted_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "state": {"const": "deleted_after_durable_intent"}
  }
}
