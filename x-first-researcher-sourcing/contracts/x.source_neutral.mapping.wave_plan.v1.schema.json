{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.source_neutral.mapping.wave_plan.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "policy_sha256",
    "manifest_sha256",
    "lab_descriptor_sha256",
    "candidate_count",
    "planned_batch_count",
    "planned_native_x_call_count",
    "candidate_refs_sha256",
    "batches",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": "x.source_neutral.mapping.wave_plan.v1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "lab_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_count": {"type": "integer", "minimum": 1},
    "planned_batch_count": {"type": "integer", "minimum": 1},
    "planned_native_x_call_count": {"type": "integer", "minimum": 1},
    "candidate_refs_sha256": {"$ref": "#/$defs/sha256"},
    "batches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/batch"}},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_call_ordinal",
        "batch_call_ordinal",
        "batch_candidate_ordinal",
        "candidate_ref",
        "expected_author_handle",
        "champion_cell_id",
        "concept_alias_group_id",
        "topic_aliases",
        "tool_name",
        "arguments"
      ],
      "properties": {
        "global_call_ordinal": {"type": "integer", "minimum": 1},
        "batch_call_ordinal": {"type": "integer", "minimum": 1},
        "batch_candidate_ordinal": {"type": "integer", "minimum": 1},
        "candidate_ref": {"$ref": "#/$defs/id"},
        "expected_author_handle": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
        "champion_cell_id": {"$ref": "#/$defs/id"},
        "concept_alias_group_id": {"$ref": "#/$defs/id"},
        "topic_aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tool_name": {"const": "x_keyword_search"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "limit", "mode"],
          "properties": {
            "query": {"type": "string", "minLength": 1, "maxLength": 10000},
            "limit": {"type": "string", "pattern": "^[1-9][0-9]?$|^100$"},
            "mode": {"enum": ["Top", "Latest"]}
          }
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "candidate_refs", "candidate_refs_sha256", "calls", "batch_sha256"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,160}$"},
        "candidate_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "candidate_refs_sha256": {"$ref": "#/$defs/sha256"},
        "calls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/call"}},
        "batch_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
