{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.source_neutral.mapping.luna_candidate_review.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_ref",
    "judged_bundle_manifest",
    "judged_bundle_sha256",
    "proposed_lab_affiliation_state",
    "proposed_pretraining_experience_state",
    "lab_affiliation_evidence_citations",
    "pretraining_experience_evidence_citations",
    "authority_status",
    "model_claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "x.source_neutral.mapping.luna_candidate_review.v1"},
    "candidate_ref": {"$ref": "#/$defs/id"},
    "judged_bundle_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/judged_item"}
    },
    "judged_bundle_sha256": {"$ref": "#/$defs/sha"},
    "proposed_lab_affiliation_state": {"$ref": "#/$defs/state"},
    "proposed_pretraining_experience_state": {"$ref": "#/$defs/state"},
    "lab_affiliation_evidence_citations": {
      "type": "array",
      "items": {"$ref": "#/$defs/citation"}
    },
    "pretraining_experience_evidence_citations": {
      "type": "array",
      "items": {"$ref": "#/$defs/citation"}
    },
    "authority_status": {"const": "diagnostic_only_unattested"},
    "model_claim_scope": {"const": "state_proposal_only"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "state": {"enum": ["current", "historical", "ambiguous", "unsupported"]},
    "citation": {
      "type": "string",
      "pattern": "^(seed_fact:[A-Za-z0-9_.:/-]{1,512}|x_bio|post:[1-9][0-9]{0,31})$"
    },
    "judged_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_ref", "source_kind", "source_status", "sha256"],
      "properties": {
        "item_ref": {"$ref": "#/$defs/citation"},
        "source_kind": {"enum": ["seed_fact", "x_bio", "x_post", "x_reply"]},
        "source_status": {
          "enum": [
            "source_bound",
            "model_mediated_unverified",
            "human_supplied_unverified",
            "fixture_synthetic"
          ]
        },
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
