{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.recall_pool.campaign.wave_request.v2.schema.json",
  "title": "X-first recall-pool upstream wave request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wave_id", "wave_result_schema_version", "target", "prompt_sha256", "expected_session_id", "expected_request_id", "expected_model_id", "strategy", "execution_context"],
  "properties": {
    "schema_version": {"const": "x.recall_pool.campaign.wave_request.v2"},
    "wave_id": {"$ref": "#/$defs/slug"},
    "wave_result_schema_version": {"const": "x.grok_cli.recall_wave.result_adapter.v2"},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["lab_id", "research_focus_id"],
      "properties": {"lab_id": {"$ref": "#/$defs/slug"}, "research_focus_id": {"$ref": "#/$defs/slug"}}
    },
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "expected_session_id": {"$ref": "#/$defs/uuid"},
    "expected_request_id": {"$ref": "#/$defs/uuid"},
    "expected_model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "strategy": {
      "type": "object", "additionalProperties": false, "required": ["strategy_id", "strategy_definition_sha256", "query_family_ids", "execution_attribution"],
      "properties": {
        "strategy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "strategy_definition_sha256": {"$ref": "#/$defs/sha256"},
        "strategy_definition": {
          "type": "object", "additionalProperties": false, "required": ["schema_version", "query_families"],
          "properties": {
            "schema_version": {"const": "x.recall_pool.campaign.strategy_definition.v1"},
            "query_families": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["family_id", "family_version", "allowed_call_shapes"],
                "properties": {
                  "family_id": {"$ref": "#/$defs/slug"},
                  "family_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
                  "allowed_call_shapes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/call_shape"}}
                }
              }
            }
          }
        },
        "query_family_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "execution_attribution": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["status", "family_call_sha256s"], "properties": {"status": {"const": "unavailable"}, "family_call_sha256s": {"type": "null"}}},
            {"type": "object", "additionalProperties": false, "required": ["status", "family_call_sha256s"], "properties": {"status": {"const": "exact_replayed_call_attribution"}, "family_call_sha256s": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}}}},
            {"type": "object", "additionalProperties": false, "required": ["status", "family_planned_call_sha256s", "attribution_plan_sha256"], "properties": {"status": {"const": "precommitted_runner_bound"}, "family_planned_call_sha256s": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}}, "attribution_plan_sha256": {"$ref": "#/$defs/sha256"}}}
          ]
        }
      }
    },
    "execution_context": {
      "type": "object", "additionalProperties": false,
      "required": ["system_prompt_sha256", "prompt_context_sha256", "prior_exclusion_binding_status"],
      "properties": {
        "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_context_sha256": {"$ref": "#/$defs/sha256"},
        "prior_exclusion_binding_status": {"enum": ["not_applicable", "system_prompt_hash_bound_operator_asserted"]},
        "user_visible_chat_context": {
          "type": "object", "additionalProperties": false, "required": ["binding_status", "sha256"],
          "properties": {"binding_status": {"const": "precommitted_exact"}, "sha256": {"$ref": "#/$defs/sha256"}}
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "call_shape": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_name", "limit", "count", "mode", "min_score_threshold", "thread_argument_shape"],
      "properties": {
        "tool_name": {"enum": ["x_keyword_search", "x_semantic_search", "x_user_search", "x_thread_fetch"]},
        "limit": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 100}]},
        "count": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 50}]},
        "mode": {"oneOf": [{"type": "null"}, {"enum": ["Latest", "Top"]}]},
        "min_score_threshold": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "thread_argument_shape": {"oneOf": [{"type": "null"}, {"enum": ["post_id", "tweet_id", "url", "query"]}]}
      }
    }
  }
}
