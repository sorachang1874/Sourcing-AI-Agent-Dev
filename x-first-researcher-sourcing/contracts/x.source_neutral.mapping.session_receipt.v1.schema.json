{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.source_neutral.mapping.session_receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "commit_allowed",
    "proof_authority",
    "errors",
    "precommit_sha256",
    "source_artifact_manifest_sha256",
    "source_artifact_count",
    "source_artifact_hashes_sha256",
    "terminal_sha256",
    "planned_native_x_call_count",
    "attested_completed_native_x_call_count",
    "x_user_search_call_count",
    "pretool_terminal_count",
    "unique_stable_post_id_count",
    "saturation_lower_bound_count",
    "references",
    "saturation_queue_seeds",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "x.source_neutral.mapping.session_receipt.v1"},
    "status": {"enum": ["accepted", "rejected"]},
    "commit_allowed": {"type": "boolean"},
    "proof_authority": {"enum": ["existing_raw_grok_six_file_replay", "operator_projected_unverified"]},
    "errors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "precommit_sha256": {"$ref": "#/$defs/nullable_sha_disallowed"},
    "source_artifact_manifest_sha256": {"$ref": "#/$defs/nullable_sha"},
    "source_artifact_count": {"type": "integer", "minimum": 0},
    "source_artifact_hashes_sha256": {"$ref": "#/$defs/nullable_sha"},
    "terminal_sha256": {"$ref": "#/$defs/nullable_sha"},
    "planned_native_x_call_count": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "attested_completed_native_x_call_count": {"type": "integer", "minimum": 0},
    "x_user_search_call_count": {"const": 0},
    "pretool_terminal_count": {"const": 0},
    "unique_stable_post_id_count": {"type": "integer", "minimum": 0},
    "saturation_lower_bound_count": {"type": "integer", "minimum": 0},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "saturation_queue_seeds": {"type": "array", "items": {"$ref": "#/$defs/saturation"}},
    "receipt_sha256": {"$ref": "#/$defs/nullable_sha_disallowed"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "nullable_sha_disallowed": {"$ref": "#/$defs/sha"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref", "stable_post_id", "url", "author_handle", "source_status", "observed_call_ordinals"],
      "properties": {
        "candidate_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "stable_post_id": {"type": "string", "pattern": "^[0-9]{1,32}$"},
        "url": {"type": "string", "minLength": 1, "maxLength": 512},
        "author_handle": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
        "source_status": {"const": "model_mediated_url_from_verified_native_x_session"},
        "observed_call_ordinals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref", "parent_call_ordinal", "concept_alias_group_id", "topic_aliases", "mode", "time_window", "next_child_rule", "reason"],
      "properties": {
        "candidate_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "parent_call_ordinal": {"type": "integer", "minimum": 1},
        "concept_alias_group_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "topic_aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mode": {"enum": ["Top", "Latest"]},
        "time_window": {"type": "null"},
        "next_child_rule": {"const": "topic"},
        "reason": {"const": "request_limit_equal_is_lower_bound_only"}
      }
    }
  }
}
