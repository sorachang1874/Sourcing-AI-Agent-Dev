{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.grok.adaptive_recall_wave.live_grant_consumption.v2.schema.json",
  "title": "Adaptive Grok recall-wave live-grant consumption v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id_hash",
    "grant_sha256",
    "execution_scope_sha256",
    "request_sha256",
    "run_id",
    "consumed_at",
    "state",
    "run_lease_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "x.grok.adaptive_recall_wave.live_grant_consumption.v2"
    },
    "grant_id_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_scope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^grok_wave_live_[0-9a-f]{32}$"
    },
    "consumed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "state": {
      "const": "consumed_after_binary_auth_preflight_before_process_spawn"
    },
    "run_lease_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
