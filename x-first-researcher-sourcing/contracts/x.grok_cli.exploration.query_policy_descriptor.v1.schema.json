{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.grok_cli.exploration.query_policy_descriptor.v1.schema.json",
  "title": "Grok CLI public exploration query-policy descriptor v1",
  "description": "Intended-public, hash-only descriptor. It contains no query arguments, handles, Bio text, or source URLs. Approval is declared by the reviewed registry and exact descriptor SHA-256; receipt calls are recomputed and matched to the ordered call hashes at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "purpose",
    "lab_id",
    "run_binding_sha256",
    "legacy_full_policy_sha256",
    "allowed_decision_dimensions",
    "professional_experience_proxy_query_allowed",
    "protected_identity_query_allowed",
    "query_manifest"
  ],
  "properties": {
    "schema_version": {"const": "x.grok_cli.exploration.query_policy_descriptor.v1"},
    "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "purpose": {"const": "base_researcher_discovery"},
    "lab_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "run_binding_sha256": {"$ref": "#/$defs/sha256"},
    "legacy_full_policy_sha256": {"$ref": "#/$defs/sha256"},
    "allowed_decision_dimensions": {
      "type": "array",
      "prefixItems": [
        {"const": "lab_affiliation"},
        {"const": "role_function"},
        {"const": "pretraining_relevance"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "professional_experience_proxy_query_allowed": {"const": false},
    "protected_identity_query_allowed": {"const": false},
    "query_manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/call_descriptor"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "call_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "tool_name", "call_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 31},
        "tool_name": {
          "enum": ["x_keyword_search", "x_semantic_search", "x_user_search", "x_thread_fetch"]
        },
        "call_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
