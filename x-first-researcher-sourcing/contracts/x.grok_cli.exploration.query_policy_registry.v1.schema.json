{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.grok_cli.exploration.query_policy_registry.v1.schema.json",
  "title": "Grok CLI approved public query-policy descriptor registry v1",
  "description": "One immutable version-named snapshot. Each row separately binds the intended-public descriptor preimage/hash and the canonical hash of its owner-only legacy full policy. Additions create a new snapshot file and registry_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "policies"],
  "properties": {
    "schema_version": {"const": "x.grok_cli.exploration.query_policy_registry.v1"},
    "registry_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_version",
          "policy_path",
          "policy_sha256",
          "legacy_full_policy_sha256",
          "policy_schema_version",
          "purpose",
          "lab_id",
          "run_binding_sha256",
          "enabled"
        ],
        "properties": {
          "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "policy_path": {"type": "string", "pattern": "^configs/[A-Za-z0-9_./-]+\\.json$"},
          "policy_sha256": {"$ref": "#/$defs/sha256"},
          "legacy_full_policy_sha256": {"$ref": "#/$defs/sha256"},
          "policy_schema_version": {"const": "x.grok_cli.exploration.query_policy_descriptor.v1"},
          "purpose": {"const": "base_researcher_discovery"},
          "lab_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "run_binding_sha256": {"$ref": "#/$defs/sha256"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
