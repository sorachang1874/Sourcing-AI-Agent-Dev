{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.profile.bio_signal.policy.v1.schema.json",
  "title": "X profile Bio signal policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "proposal_kinds",
    "china_ecosystems",
    "ownership_positive_grammar",
    "affiliation_positive_grammars",
    "limits",
    "forbidden_proposal_fields"
  ],
  "const": {
    "schema_version": "x.profile.bio_signal.policy.v1",
    "policy_version": "profile-bio-signal-v1.4",
    "proposal_kinds": [
      "observed_chinese_content",
      "china_ecosystem_self_claim",
      "organization_mention"
    ],
    "china_ecosystems": [
      {
        "ecosystem_id": "xiaohongshu",
        "aliases": [
          "小红书",
          "Xiaohongshu",
          "REDnote"
        ],
        "subject_claim_templates": [
          "同名{alias}",
          "{alias}同名",
          "我的{alias}",
          "本人运营{alias}",
          "我运营{alias}",
          "我在{alias}发布",
          "my {alias} account",
          "i run {alias}",
          "i publish on {alias}",
          "same-name {alias}"
        ],
        "bare_alias_identifier_claim": false
      },
      {
        "ecosystem_id": "wechat_official_account",
        "aliases": [
          "公众号",
          "微信公众号",
          "WeChat Official Account"
        ],
        "subject_claim_templates": [
          "同名{alias}",
          "{alias}同名",
          "我的{alias}",
          "本人运营{alias}",
          "我运营{alias}",
          "我在{alias}发布",
          "my {alias} account",
          "i run {alias}",
          "i publish on {alias}",
          "same-name {alias}"
        ],
        "bare_alias_identifier_claim": true
      }
    ],
    "ownership_positive_grammar": {
      "mode": "single_window_positive_fullmatch_v1",
      "continuation_classes": [
        "account_identifier",
        "ownership_noun",
        "parenthetical_note",
        "audience_count"
      ],
      "bare_alias_continuation_class": "account_identifier",
      "parenthetical_note_values": [
        "长文首发"
      ],
      "rejected_unicode_categories": [
        "Cc",
        "Cf"
      ]
    },
    "affiliation_positive_grammars": [
      {
        "relation": "current",
        "grammar_ids": [
          "head_of_role",
          "founder_at_handle",
          "researcher_at_handle",
          "engineer_at_handle",
          "employed_at_cn_handle",
          "works_at_cn_handle"
        ]
      },
      {
        "relation": "previous",
        "grammar_ids": [
          "prev_handles",
          "previously_handles",
          "formerly_handles",
          "former_role",
          "former_cn_handles",
          "previous_employed_at_cn_handle",
          "prior_employed_at_cn_handle"
        ]
      }
    ],
    "limits": {
      "max_bio_characters": 2000,
      "max_display_alias_characters": 100,
      "max_proposals": 32,
      "max_excerpt_characters": 500,
      "max_role_text_characters": 120,
      "max_nested_validation_depth": 64,
      "max_nested_validation_nodes": 4096
    },
    "forbidden_proposal_fields": [
      "ancestry",
      "citizenship",
      "ethnicity",
      "gender",
      "nationality",
      "race",
      "real_name",
      "religion"
    ]
  },
  "properties": {
    "schema_version": {
      "const": "x.profile.bio_signal.policy.v1"
    },
    "policy_version": {
      "const": "profile-bio-signal-v1.4"
    },
    "proposal_kinds": {
      "type": "array"
    },
    "china_ecosystems": {
      "type": "array"
    },
    "ownership_positive_grammar": {
      "type": "object"
    },
    "affiliation_positive_grammars": {
      "type": "array"
    },
    "limits": {
      "type": "object"
    },
    "forbidden_proposal_fields": {
      "type": "array"
    }
  }
}
