      "regex_dialect": "python-re-fullmatch-v1",
      "case_insensitive": true,
      "rejected_unicode_categories": [
        "Cc",
        "Cf"
      ],
      "ownership": {
        "mode": "single_window_positive_fullmatch_v2",
        "claim_forms": [
          {
            "form_id": "same_name_prefix",
            "template": "同名{alias}",
            "allow_empty": true,
            "continuation_ids": [
              "ownership_noun",
              "parenthetical_note",
              "audience_count"
            ]
          },
          {
            "form_id": "same_name_suffix",
            "template": "{alias}同名",
            "allow_empty": true,
            "continuation_ids": [
              "ownership_noun",
              "parenthetical_note",
              "audience_count"
            ]
          },
          {
            "form_id": "my_cn_standard",
            "template": "我的{alias}",
            "allow_empty": true,
            "continuation_ids": [
              "ownership_noun",
              "parenthetical_note",
              "audience_count"
            ]
          },
          {
            "form_id": "my_cn_account_identifier",
            "template": "我的{alias}",
            "allow_empty": true,
            "continuation_ids": [
              "account_identifier",
              "ownership_noun",
              "parenthetical_note",
              "audience_count"
