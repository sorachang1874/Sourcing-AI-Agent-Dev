          {
            "form_id": "publish_cn",
            "template": "我在{alias}发布",
            "allow_empty": true,
            "continuation_ids": [
              "parenthetical_note",
              "audience_count"
            ]
          },
          {
            "form_id": "my_en_account",
            "template": "my {alias} account",
            "allow_empty": true,
            "continuation_ids": [
              "parenthetical_note",
              "audience_count"
            ]
          },
          {
            "form_id": "run_en",
            "template": "i run {alias}",
            "allow_empty": true,
            "continuation_ids": [
              "ownership_noun",
              "parenthetical_note",
              "audience_count"
