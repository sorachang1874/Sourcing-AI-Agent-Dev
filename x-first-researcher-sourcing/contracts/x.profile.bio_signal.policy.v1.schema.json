            "relation": "current",
            "grammars": [
              {
                "grammar_id": "head_of_closed_function_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "(?P<role>Head +of +(?:growth|research|engineering|AI)) +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": "role"
              },
              {
                "grammar_id": "founder_at_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "(?P<role>Founder) +at +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": "role"
              },
              {
                "grammar_id": "researcher_at_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "(?P<role>Researcher) +at +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": "role"
              },
              {
                "grammar_id": "engineer_at_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "(?P<role>Engineer) +at +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": "role"
