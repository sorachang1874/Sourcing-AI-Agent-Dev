            "allow_empty": true,
            "continuation_ids": [
              "ownership_noun",
              "parenthetical_note",
              "audience_count"
            ]
          }
        ],
        "continuations": [
          {
            "continuation_id": "account_identifier",
            "ast_node": "regex_fullmatch",
            "pattern": "[a-z0-9_][a-z0-9_.-]{1,79}(?:\\s*\\((?P<note>[^()\\r\\n]{1,80})\\))?",
            "note_group": "note",
            "note_values": [
              "长文首发"
            ]
          },
          {
            "continuation_id": "ownership_noun",
            "ast_node": "regex_fullmatch",
            "pattern": "(?:账号|账户|account|channel)(?:\\s*\\((?P<note>[^()\\r\\n]{1,80})\\))?",
            "note_group": "note",
            "note_values": [
              "长文首发"
            ]
          },
          {
            "continuation_id": "parenthetical_note",
            "ast_node": "regex_fullmatch",
            "pattern": "\\((?P<note>[^()\\r\\n]{1,80})\\)",
            "note_group": "note",
            "note_values": [
              "长文首发"
            ]
          },
          {
            "continuation_id": "audience_count",
            "ast_node": "regex_fullmatch",
            "pattern": "(?:用户数(?:[0-9]+(?:\\.[0-9]+)?(?:k|m|万|千)?|[零〇一二两三四五六七八九十百千万亿]+)|(?:[0-9]+(?:\\.[0-9]+)?(?:k|m|万|千)?|[零〇一二两三四五六七八九十百千万亿]+)(?:粉丝|关注者|followers?))",
            "note_group": null,
            "note_values": []
          }
        ]
      },
      "affiliation": {
