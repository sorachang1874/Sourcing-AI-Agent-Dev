                "handle_binding": "named_group_equals",
                "role_group": null
              },
              {
                "grammar_id": "works_at_cn_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "就职于 +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": null
              }
            ]
          },
          {
            "relation": "previous",
            "grammars": [
              {
                "grammar_id": "prev_handles",
                "ast_node": "regex_fullmatch",
                "pattern": "Prev(?: +@[A-Za-z0-9_]{1,15}){1,8}",
                "handle_binding": "mention_set_contains",
                "role_group": null
              },
              {
                "grammar_id": "previously_handles",
                "ast_node": "regex_fullmatch",
                "pattern": "Previously(?: +@[A-Za-z0-9_]{1,15}){1,8}",
                "handle_binding": "mention_set_contains",
                "role_group": null
