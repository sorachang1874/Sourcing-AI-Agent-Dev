                "handle_binding": "mention_set_contains",
                "role_group": null
              },
              {
                "grammar_id": "former_closed_role_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "Former +(?P<role>(?:Researcher|Engineer|Founder|Head +of +(?:growth|research|engineering|AI))) +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": "role"
              },
              {
                "grammar_id": "former_cn_handles",
                "ast_node": "regex_fullmatch",
                "pattern": "曾任(?: +@[A-Za-z0-9_]{1,15}){1,8}",
                "handle_binding": "mention_set_contains",
                "role_group": null
              },
              {
                "grammar_id": "previous_employed_at_cn_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "前任职于 +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": null
              },
              {
                "grammar_id": "prior_employed_at_cn_handle",
                "ast_node": "regex_fullmatch",
                "pattern": "此前任职于 +@(?P<handle>[A-Za-z0-9_]{1,15})",
                "handle_binding": "named_group_equals",
                "role_group": null
              }
            ]
          }
        ]
      }
    },
    "grammar_runtime_binding": {
      "runtime_id": "profile-bio-policy-regex-interpreter-v1",
      "implementation_sha256": "d7735fe35fbb524465cea2a4a6eb9ac8384d11da2afd54981b7c810600c13a9b"
