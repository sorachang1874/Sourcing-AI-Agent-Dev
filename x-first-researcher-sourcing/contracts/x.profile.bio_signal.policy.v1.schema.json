          "REDnote"
        ],
        "claim_form_ids": [
          "same_name_prefix",
          "same_name_suffix",
          "my_cn_standard",
          "operated_by_me_formal",
          "operated_by_me",
          "publish_cn",
          "my_en_account",
          "run_en",
          "publish_en",
          "same_name_en"
