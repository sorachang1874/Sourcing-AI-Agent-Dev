{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.grok.adaptive_recall_wave.operator_receipt.v2.schema.json",
  "title": "Adaptive Grok recall-wave operator receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "request_sha256",
    "execution_mode",
    "status",
    "input_binding",
    "command_binding",
    "approval",
    "process",
    "artifacts",
    "reconciliation",
    "authority",
    "run_lease_sha256",
    "session_proof",
    "retention"
  ],
  "properties": {
    "schema_version": {
      "const": "x.grok.adaptive_recall_wave.operator_receipt.v2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^grok_wave_(fixture|live)_[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^xwave_req_[0-9a-f]{32}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "status": {
      "enum": [
        "fixture_complete",
        "completed",
        "process_failed",
        "timed_out",
        "structured_output_noncompliant",
        "result_contract_invalid",
        "crash_recovered",
        "technical_limit_exceeded",
        "provider_evidence_invalid"
      ]
    },
    "input_binding": {
      "$ref": "#/$defs/input_binding"
    },
    "command_binding": {
      "$ref": "#/$defs/command_binding"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at",
        "elapsed_ms",
        "exit_code",
        "timed_out",
        "term_sent",
        "kill_sent",
        "process_spawn_attempted",
        "child_pid",
        "process_group_id",
        "process_ledger_sha256",
        "kernel_birth_identity_sha256",
        "process_identity_token_sha256",
        "process_group_cleanup_confirmed",
        "execution_error_code",
        "deadline_ms",
        "term_grace_ms",
        "kill_grace_ms",
        "fallback_used",
        "technical_limit_exceeded",
        "technical_limit_kind"
      ],
      "properties": {
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "term_sent": {
          "type": "boolean"
        },
        "kill_sent": {
          "type": "boolean"
        },
        "process_spawn_attempted": {
          "type": "boolean"
        },
        "child_pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "process_group_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "process_ledger_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "kernel_birth_identity_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "process_identity_token_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "process_group_cleanup_confirmed": {
          "type": "boolean"
        },
        "execution_error_code": {
          "enum": [
            "none",
            "spawn_failed",
            "process_execution_failed",
            "process_group_cleanup_failed",
            "crash_recovered"
          ]
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "term_grace_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "kill_grace_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "fallback_used": {
          "const": false
        },
        "technical_limit_exceeded": {
          "type": "boolean"
        },
        "technical_limit_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "stdout_bytes",
            "stderr_bytes",
            "json_bytes",
            "json_structure",
            "session_tree_files",
            "session_tree_entries",
            "session_tree_depth",
            "session_tree_file_bytes",
            "session_tree_total_bytes",
            "session_updates_bytes",
            "session_tree_entry_invalid",
            "session_tree_unexpected_socket",
            "session_tree_scan_deadline"
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_stdout_sha256",
        "stderr_sha256",
        "sanitized_output_sha256",
        "structured_output_compliant",
        "structured_output_contract_valid",
        "non_json_prefix_bytes",
        "non_json_suffix_bytes",
        "compiled_prompt_sha256",
        "session_updates_sha256",
        "ephemeral_tree_deleted",
        "session_tree_file_count",
        "session_tree_entry_count",
        "session_tree_max_depth",
        "session_tree_total_bytes",
        "session_tree_max_file_bytes"
      ],
      "properties": {
        "raw_stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sanitized_output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "structured_output_compliant": {
          "type": "boolean"
        },
        "structured_output_contract_valid": {
          "type": "boolean"
        },
        "non_json_prefix_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "non_json_suffix_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "compiled_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "session_updates_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "ephemeral_tree_deleted": {
          "const": true
        },
        "session_tree_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "session_tree_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "session_tree_max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "session_tree_total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "session_tree_max_file_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reconciliation": {
      "$ref": "#/$defs/reconciliation"
    },
    "authority": {
      "$ref": "x.grok.adaptive_recall_wave.request.v2.schema.json#/properties/authority"
    },
    "run_lease_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "session_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "updates_sha256",
        "update_bytes",
        "event_count",
        "provider_prompt_id_sha256",
        "effective_model_id",
        "started_tool_calls",
        "completed_tool_calls",
        "tool_counts",
        "query_argument_sha256s",
        "terminal_stop_reason",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "model_turns",
        "estimated_cost_usd_micros"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "missing",
            "invalid",
            "verified"
          ]
        },
        "updates_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "update_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "provider_prompt_id_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "completed_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "query_argument_sha256s": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "terminal_stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_usd_micros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "ttl_seconds",
        "delete_after",
        "purge_state",
        "deletion_receipt_required"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 604800
        },
        "delete_after": {
          "$ref": "#/$defs/timestamp"
        },
        "purge_state": {
          "const": "pending_expiry"
        },
        "deletion_receipt_required": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha256",
        "source_prompt_sha256",
        "compiled_prompt_sha256",
        "prior_waves",
        "prior_unique_handle_count",
        "prior_handle_set_sha256"
      ],
      "properties": {
        "target_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compiled_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prior_waves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wave_id",
              "sha256",
              "candidate_count",
              "unique_handle_count",
              "handle_set_sha256"
            ],
            "properties": {
              "wave_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 0
              },
              "unique_handle_count": {
                "type": "integer",
                "minimum": 0
              },
              "handle_set_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "prior_unique_handle_count": {
          "type": "integer",
          "minimum": 0
        },
        "prior_handle_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "command_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "reasoning_effort",
        "session_id",
        "grok_binary_sha256",
        "structured_output_schema_sha256",
        "argv_sha256",
        "command_policy_sha256",
        "environment_policy_sha256",
        "tool_registry_sha256",
        "effective_prompt_policy_sha256",
        "effective_prompt_policy_entry_id",
        "operator_account_ref_sha256",
        "oauth_auth_sha256",
        "max_turns"
      ],
      "properties": {
        "provider_id": {
          "const": "grok_cli_oauth"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "grok_binary_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "structured_output_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "effective_prompt_policy_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_prompt_policy_entry_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "operator_account_ref_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "oauth_auth_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "grant_id_sha256",
        "grant_sha256",
        "consumption_sha256"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "grant_id_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "grant_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "consumption_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "evidence_count",
        "post_url_count",
        "prior_overlap_count",
        "verified_material_update_count",
        "model_reported_tool_calls",
        "mechanically_verified_tool_calls",
        "tool_fact_source"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "post_url_count": {
          "type": "integer",
          "minimum": 0
        },
        "prior_overlap_count": {
          "type": "integer",
          "minimum": 0
        },
        "verified_material_update_count": {
          "type": "integer",
          "minimum": 0
        },
        "model_reported_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "mechanically_verified_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_fact_source": {
          "enum": [
            "fixture_not_applicable",
            "session_transcript_verified",
            "session_transcript_unverified"
          ]
        }
      }
    }
  }
}
