{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.portable.selected_subject.request_binding.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_id",
    "campaign_id",
    "selection_schema_version",
    "selection_contract_schema_sha256",
    "selection_artifact_sha256",
    "portable_request_schema_version",
    "portable_request_contract_schema_sha256",
    "portable_request_sha256",
    "subject_bindings",
    "authority",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {"const": "x.portable.selected_subject.request_binding.v1"},
    "selection_id": {"$ref": "#/$defs/identifier"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "selection_schema_version": {"const": "sourcing.x_first.subject_selection.v1"},
    "selection_contract_schema_sha256": {"$ref": "#/$defs/sha256"},
    "selection_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "portable_request_schema_version": {"const": "x.portable.research_campaign.request.v1"},
    "portable_request_contract_schema_sha256": {"$ref": "#/$defs/sha256"},
    "portable_request_sha256": {"$ref": "#/$defs/sha256"},
    "subject_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subject_binding"}
    },
    "authority": {
      "const": {
        "provider_calls_allowed": false,
        "product_writes_allowed": false,
        "canonical_person_merge_allowed": false,
        "outreach_allowed": false
      }
    },
    "binding_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_subject_ref",
        "source_record_ref",
        "source_record_sha256",
        "source_kind",
        "seed_ref",
        "seed_sha256"
      ],
      "properties": {
        "source_subject_ref": {"$ref": "#/$defs/identifier"},
        "source_record_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {
          "enum": ["linkedin_profile", "professional_profile", "name_only"]
        },
        "seed_ref": {"$ref": "#/$defs/identifier"},
        "seed_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
