                          "observed_chinese_professional_content"
                        ]
                      },
                      "confidence": {"enum": ["high", "medium", "low"]},
                      "mapped_strength": {"enum": ["strong_proxy", "weak_proxy"]}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "Policy-derived, unverified high-recall professional-experience proxies with proposal provenance. They are neither physical-region evidence nor protected identity inference."
