          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "source",
        "billable"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
