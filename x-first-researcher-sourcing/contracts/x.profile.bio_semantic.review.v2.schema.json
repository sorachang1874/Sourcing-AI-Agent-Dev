        "response_status": {
          "const": "completed"
        },
        "model_id": {
          "const": "gpt-5.6-luna"
        },
        "prompt_version": {
          "const": "profile-bio-semantic-prompt-v2.2"
        },
        "prompt_sha256": {
          "type": "string",
