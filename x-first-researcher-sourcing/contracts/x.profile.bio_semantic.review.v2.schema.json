{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.profile.bio_semantic.review.v2.2.schema.json",
  "title": "Validated X profile Bio semantic review v2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "request_id",
    "request_sha256",
    "profile_snapshot_id",
    "platform_user_id",
    "bio_sha256",
    "execution",
    "model_receipt",
    "usage",
    "verdict",
    "proposals",
    "professional_experience_proxy_policy",
    "professional_experience_proxy_rollup",
    "error_codes",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "x.profile.bio_semantic.review.v2.2"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^xbsv2r_[0-9a-f]{24}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_snapshot_id": {
      "type": "string",
      "pattern": "^xbsv2s_[0-9a-f]{24}$"
    },
    "platform_user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{1,24}$"
    },
    "bio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "transport_id",
        "execute_live",
        "transport_invocations",
        "provider_external_calls",
        "response_received",
        "fallback_used",
        "phase",
        "contract_error"
      ],
      "properties": {
        "mode": {
          "enum": [
            "offline_fake",
            "live",
            "invalid",
            "not_inspected"
          ]
        },
        "transport_id": {
          "enum": [
            "offline_fake_responses",
            "openai_compatible_responses",
            "invalid",
            "not_inspected"
          ]
        },
        "execute_live": {
          "type": ["boolean", "null"]
        },
        "transport_invocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "provider_external_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "response_received": {
          "type": "boolean"
        },
        "fallback_used": {
          "const": false
        },
        "phase": {
          "enum": ["preflight", "authorization", "transport", "response", "semantic", "completed"]
        },
        "contract_error": {
          "enum": [
            "none",
            "not_evaluated",
            "invalid_is_live",
            "invalid_transport_id",
            "transport_pair_mismatch",
            "invalid_execute_live",
            "offline_execute_live"
          ]
        }
      }
    },
    "model_receipt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "response_id",
        "response_status",
        "model_id",
        "prompt_version",
        "prompt_sha256",
        "output_schema_version",
        "output_schema_sha256",
        "raw_response_sha256",
        "model_output_sha256"
