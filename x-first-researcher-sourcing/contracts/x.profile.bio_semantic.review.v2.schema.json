{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.profile.bio_semantic.review.v2.schema.json",
  "title": "Validated X profile Bio semantic review v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "request_id",
    "request_sha256",
    "profile_snapshot_id",
    "platform_user_id",
    "bio_sha256",
    "execution",
    "model_receipt",
    "usage",
    "verdict",
    "proposals",
    "error_codes",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "x.profile.bio_semantic.review.v2"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^xbsv2r_[0-9a-f]{24}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_snapshot_id": {
      "type": "string",
      "pattern": "^xbsv2s_[0-9a-f]{24}$"
    },
    "platform_user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{1,24}$"
    },
    "bio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "transport_id",
        "execute_live",
        "provider_external_calls",
        "fallback_used"
      ],
      "properties": {
        "mode": {
          "enum": [
            "offline_fake",
            "live"
          ]
        },
        "transport_id": {
          "enum": [
            "offline_fake_responses",
            "openai_compatible_responses"
          ]
        },
        "execute_live": {
          "type": "boolean"
        },
        "provider_external_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "fallback_used": {
          "const": false
        }
      }
    },
    "model_receipt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "response_id",
        "response_status",
        "model_id",
        "prompt_version",
        "prompt_sha256",
        "output_schema_version",
        "output_schema_sha256",
        "raw_response_sha256",
        "model_output_sha256"
      ],
      "properties": {
        "response_id": {
          "type": "string",
          "pattern": "^resp_[A-Za-z0-9_-]{8,120}$"
        },
        "response_status": {
          "const": "completed"
        },
        "model_id": {
          "const": "gpt-5.6-luna"
        },
        "prompt_version": {
          "const": "profile-bio-semantic-prompt-v2.0"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_schema_version": {
          "const": "x.profile.bio_semantic.model_output.v2"
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "source",
        "billable"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "enum": [
            "offline_fake",
            "provider_reported"
          ]
        },
        "billable": {
          "type": "boolean"
        }
      }
    },
    "verdict": {
      "enum": [
        "proposals_available",
        "no_supported_professional_context",
        "abstained"
      ]
    },
    "proposals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "proposal_type",
          "relation_state",
          "span_start",
          "span_end",
          "excerpt",
          "excerpt_sha256",
          "reason_codes",
          "reason",
          "reason_source",
          "confidence",
          "evidence_basis",
          "requires_independent_verification",
          "verification_status"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^xbsv2p_[0-9a-f]{24}$"
          },
          "proposal_type": {
            "enum": [
              "professional_region_experience",
              "professional_china_digital_ecosystem",
              "professional_affiliation",
              "observed_chinese_professional_content"
            ]
          },
          "relation_state": {
            "enum": [
              "current_claimed",
              "previous_claimed",
              "future_or_aspirational",
              "unspecified",
              "not_applicable"
            ]
          },
          "span_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "span_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "excerpt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "enum": [
                "explicit_professional_region_experience",
                "explicit_china_digital_ecosystem_activity",
                "explicit_current_organization_claim",
                "explicit_previous_organization_claim",
                "observed_chinese_professional_content",
                "ambiguous_professional_context_requires_review"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "reason_source": {
            "const": "model_proposed"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_basis": {
            "const": "profile_bio_only"
          },
          "requires_independent_verification": {
            "const": true
          },
          "verification_status": {
            "const": "unverified_professional_context_proposal"
          }
        }
      }
    },
    "error_codes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "request_invalid",
          "prompt_invalid",
          "output_schema_invalid",
          "execute_live_required",
          "request_mode_mismatch",
          "transport_failed",
          "response_invalid",
          "model_output_invalid",
          "budget_exceeded"
        ]
      }
    },
    "authority": {
      "const": {
        "external_facts_accepted": false,
        "protected_identity_inferred": false,
        "discovery_or_ranking_authorized": false,
        "eligibility_decided": false,
        "canonical_employment_confirmed": false,
        "canonical_write_authorized": false,
        "outreach_authorized": false
      }
    }
  }
}
