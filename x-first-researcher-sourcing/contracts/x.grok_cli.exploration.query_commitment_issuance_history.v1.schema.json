{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.grok_cli.exploration.query_commitment_issuance_history.v1.schema.json",
  "title": "Grok CLI query commitment issuance history v1",
  "description": "The single append-only owner of issuance, policy, run, key, and nonce identities across every immutable query-policy registry snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "history_version", "issuances"],
  "properties": {
    "schema_version": {"const": "x.grok_cli.exploration.query_commitment_issuance_history.v1"},
    "history_version": {"const": "approved-query-commitment-issuances-v1"},
    "issuances": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/commitment_issuance"}
    }
  },
  "$defs": {
    "commitment_issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_position",
        "issuance_id",
        "policy_version",
        "run_binding_commitment",
        "commitment_key_id",
        "commitment_nonce_id"
      ],
      "properties": {
        "lineage_position": {"type": "integer", "minimum": 0},
        "issuance_id": {"type": "string", "pattern": "^qci_[0-9a-f]{24}$"},
        "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "run_binding_commitment": {"$ref": "#/$defs/sha256"},
        "commitment_key_id": {"$ref": "#/$defs/sha256"},
        "commitment_nonce_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
