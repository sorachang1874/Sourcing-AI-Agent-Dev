{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.grok.compact_discovery.result.v1.schema.json",
  "title": "Compact Grok discovery result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "campaign_id",
    "target_descriptor_id",
    "target_descriptor_sha256",
    "prompt_policy_sha256",
    "result_kind",
    "shard_id",
    "input_shards",
    "status",
    "strategy_id",
    "leads",
    "identity_resolution_sidecars",
    "coverage_cells",
    "uncovered_cells",
    "limitations"
  ],
  "properties": {
    "contract_version": {"const": "x.grok.compact_discovery.result.v1"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "target_descriptor_id": {"$ref": "#/$defs/identifier"},
    "target_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_policy_sha256": {"$ref": "#/$defs/sha256"},
    "result_kind": {"enum": ["shard", "union"]},
    "shard_id": {"$ref": "#/$defs/identifier"},
    "input_shards": {
      "type": "array",
      "items": {"$ref": "#/$defs/input_shard"}
    },
    "status": {
      "enum": ["X_DISCOVERY_OK", "X_DISCOVERY_PARTIAL", "X_DISCOVERY_BLOCKED"]
    },
    "strategy_id": {"$ref": "#/$defs/identifier"},
    "leads": {
      "type": "array",
      "items": {"$ref": "#/$defs/lead"}
    },
    "identity_resolution_sidecars": {
      "type": "array",
      "items": {"$ref": "#/$defs/identity_resolution_sidecar"}
    },
    "coverage_cells": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/coverage_cell"}
    },
    "uncovered_cells": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/coverage_cell"}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/limitation"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"result_kind": {"const": "shard"}},
        "required": ["result_kind"]
      },
      "then": {
        "properties": {
          "leads": {
            "items": {
              "allOf": [
                {"properties": {"lookup_handle": {"type": "null"}}},
                {"properties": {"identity_conflicts": {"maxItems": 0}}}
              ]
            }
          },
          "identity_resolution_sidecars": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shard_id", "projected_result_sha256"],
      "properties": {
        "shard_id": {"$ref": "#/$defs/identifier"},
        "projected_result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{1,15}$"
    },
    "origin_shard_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "handle_history_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "profile_url", "source_status", "origin_shard_ids"],
      "properties": {
        "handle": {"$ref": "#/$defs/handle"},
        "profile_url": {
          "type": "string",
          "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}$"
        },
        "source_status": {"const": "model_mediated_unverified"},
        "origin_shard_ids": {"$ref": "#/$defs/origin_shard_ids"}
      }
    },
    "identity_resolution_sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "candidate_platform_user_ids",
        "provisional_lead_sha256s",
        "provisional_source_ref_sha256s",
        "origin_shard_ids"
      ],
      "properties": {
        "handle": {"$ref": "#/$defs/handle"},
        "candidate_platform_user_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}
        },
        "provisional_lead_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "provisional_source_ref_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "origin_shard_ids": {"$ref": "#/$defs/origin_shard_ids"}
      }
    },
    "temporal_state": {
      "enum": ["current", "historical", "ambiguous"]
    },
    "coverage_cell": {
      "enum": [
        "official_account_profiles",
        "official_account_posts",
        "official_account_mentions",
        "candidate_profiles",
        "candidate_authored_posts",
        "candidate_replies",
        "candidate_quotes_and_threads",
        "research_artifact_author_graph"
      ]
    },
    "limitation": {
      "enum": [
        "native_x_search_incomplete",
        "profile_hydration_incomplete",
        "thread_hydration_incomplete",
        "result_truncated",
        "execution_deadline_reached",
        "transport_failure",
        "model_output_repaired"
      ]
    },
    "reason_code": {
      "enum": [
        "lab_affiliation_current_signal",
        "lab_affiliation_historical_signal",
        "lab_affiliation_ambiguous_signal",
        "pretraining_relevance_current_signal",
        "pretraining_relevance_historical_signal",
        "pretraining_relevance_ambiguous_signal"
      ]
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "url",
        "subject_handle",
        "author_handle",
        "support_dimensions",
        "origin_shard_ids"
      ],
      "properties": {
        "surface": {
          "enum": [
            "profile",
            "bio",
            "self_post",
            "reply",
            "quote",
            "mention",
            "official_post",
            "thread"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}(?:/status/[1-9][0-9]{0,19})?$"
        },
        "subject_handle": {"$ref": "#/$defs/handle"},
        "author_handle": {"$ref": "#/$defs/handle"},
        "support_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["lab_affiliation", "pretraining_relevance"]}
        },
        "origin_shard_ids": {"$ref": "#/$defs/origin_shard_ids"}
      }
    },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "profile_url",
        "platform_user_id",
        "identity_status",
        "lookup_handle",
        "identity_conflicts",
        "handle_history_proposals",
        "origin_shard_ids",
        "target_lab_affiliation_state",
        "pretraining_experience_state",
        "source_status",
        "source_refs",
        "reason_codes"
      ],
      "properties": {
        "handle": {"$ref": "#/$defs/handle"},
        "profile_url": {
          "type": "string",
          "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}$"
        },
        "platform_user_id": {
          "type": ["string", "null"],
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "identity_status": {
          "enum": ["stable_platform_id", "provisional_handle", "quarantined_handle_reuse"]
        },
        "lookup_handle": {
          "anyOf": [
            {"$ref": "#/$defs/handle"},
            {"type": "null"}
          ]
        },
        "identity_conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "same_handle_provisional_evidence_absorbed",
              "same_handle_multiple_stable_ids_unresolved"
            ]
          }
        },
        "handle_history_proposals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/handle_history_proposal"}
        },
        "origin_shard_ids": {"$ref": "#/$defs/origin_shard_ids"},
        "target_lab_affiliation_state": {"$ref": "#/$defs/temporal_state"},
        "pretraining_experience_state": {"$ref": "#/$defs/temporal_state"},
        "source_status": {"const": "model_mediated_unverified"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_ref"}
        },
        "reason_codes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reason_code"}
        }
      }
    }
  }
}
