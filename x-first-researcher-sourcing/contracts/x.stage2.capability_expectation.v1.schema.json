{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.stage2.capability_expectation.v1.schema.json",
  "title": "X-first Stage 2A capability expectation manifest v1",
  "description": "Offline fixture expectations copied from the request-frozen scenario manifest. The expectation binds the exact request SHA and repeats both request-owned scenario/semantic digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_mode",
    "manifest_id",
    "experiment_id",
    "request_sha256",
    "expectation_version",
    "scenario_manifest_sha256",
    "expectation_semantics_sha256",
    "rows",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "x.stage2.capability_expectation.v1"},
    "execution_mode": {"const": "offline_fixture"},
    "manifest_id": {"type": "string", "pattern": "^xstage2expect_[0-9a-f]{24}$"},
    "experiment_id": {"type": "string", "pattern": "^xstage2exp_[0-9a-f]{24}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectation_version": {"const": "stage2-field-capability-fixture-expectation-v1"},
    "scenario_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectation_semantics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectation_row_id",
          "task_id",
          "scenario_id",
          "expected_terminal_status",
          "expected_error_codes",
          "expected_quarantine_reason",
          "expected_field_states",
          "expected_profile_count",
          "expected_post_count",
          "expected_source_record_kinds"
        ],
        "properties": {
          "expectation_row_id": {"type": "string", "pattern": "^xstage2expectrow_[0-9a-f]{24}$"},
          "task_id": {"type": "string", "pattern": "^xstage2task_[0-9a-f]{24}$"},
          "scenario_id": {
            "enum": [
              "exact_profile_and_same_account_post",
              "conflicting_platform_user_ids",
              "handle_rename_requires_review",
              "metadata_only_source_payload_unavailable",
              "post_only_profile_source_unavailable"
            ]
          },
          "expected_terminal_status": {"enum": ["completed", "completed_post_only", "quarantined", "failed"]},
          "expected_error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "expected_quarantine_reason": {"type": ["string", "null"]},
          "expected_field_states": {
            "type": "array",
            "minItems": 14,
            "maxItems": 14,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field_id", "state"],
              "properties": {
                "field_id": {"type": "string"},
                "state": {"enum": ["present_exact", "present_bounded", "absent", "unverified"]}
              }
            }
          },
          "expected_profile_count": {"type": "integer", "minimum": 0, "maximum": 1},
          "expected_post_count": {"type": "integer", "minimum": 0, "maximum": 1},
          "expected_source_record_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["profile", "post", "tool_metadata_only"]}
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_x_capability_claimed", "canonical_person_or_employment_confirmed", "automatic_identity_merge_performed", "discovery_or_ranking_authorized", "canonical_write_authorized", "outreach_authorized"],
      "properties": {
        "live_x_capability_claimed": {"type": "boolean", "const": false},
        "canonical_person_or_employment_confirmed": {"type": "boolean", "const": false},
        "automatic_identity_merge_performed": {"type": "boolean", "const": false},
        "discovery_or_ranking_authorized": {"type": "boolean", "const": false},
        "canonical_write_authorized": {"type": "boolean", "const": false},
        "outreach_authorized": {"type": "boolean", "const": false}
      }
    }
  }
}
