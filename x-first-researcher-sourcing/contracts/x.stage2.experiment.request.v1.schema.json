{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.stage2.experiment.request.v1.schema.json",
  "title": "X-first Stage 2A field-capability experiment request v1",
  "description": "Closed outer envelope. The request SHA-binds the external selection denominator and a closed pre-collection fixture-scenario manifest whose rows own the expectation semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_mode",
    "experiment_id",
    "target",
    "field_registry",
    "normalization_contract_version",
    "source_manifest",
    "fixture_scenario_manifest",
    "tasks",
    "technical_limits",
    "retention_policy",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "x.stage2.experiment.request.v1"},
    "execution_mode": {"const": "offline_fixture"},
    "experiment_id": {"type": "string", "pattern": "^xstage2exp_[0-9a-f]{24}$"},
    "target": {"type": "object"},
    "field_registry": {"type": "object"},
    "normalization_contract_version": {"const": "x.stage2.field_normalization.v1"},
    "source_manifest": {"type": "object"},
    "fixture_scenario_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_version",
        "scenario_manifest_sha256",
        "expectation_semantics_sha256",
        "rows"
      ],
      "properties": {
        "manifest_version": {"const": "stage2-field-capability-fixture-scenarios-v1"},
        "scenario_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expectation_semantics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/scenario_row"}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"type": "object"}
    },
    "technical_limits": {"type": "object"},
    "retention_policy": {"type": "object"},
    "authority": {"type": "object"}
  },
  "$defs": {
    "scenario_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "scenario_id",
        "expected_terminal_status",
        "expected_error_codes",
        "expected_quarantine_reason",
        "expected_field_states",
        "expected_profile_count",
        "expected_post_count",
        "expected_source_record_kinds"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^xstage2task_[0-9a-f]{24}$"},
        "scenario_id": {
          "enum": [
            "exact_profile_and_same_account_post",
            "conflicting_platform_user_ids",
            "handle_rename_requires_review",
            "metadata_only_source_payload_unavailable"
          ]
        },
        "expected_terminal_status": {"enum": ["completed", "quarantined", "failed"]},
        "expected_error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "expected_quarantine_reason": {
          "type": ["string", "null"]
        },
        "expected_field_states": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {"type": "object"}
        },
        "expected_profile_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "expected_post_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "expected_source_record_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["profile", "post", "tool_metadata_only"]}
        }
      }
    }
  }
}
