{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.stage2.experiment.request.v1.schema.json",
  "title": "X-first Stage 2A field-capability experiment request v1",
  "description": "Closed request envelope with deep types and experiment-scoped task identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_mode", "experiment_id", "target", "field_registry",
    "normalization_contract_version", "source_manifest", "fixture_scenario_manifest", "tasks",
    "technical_limits", "retention_policy", "authority"
  ],
  "properties": {
    "schema_version": {"const": "x.stage2.experiment.request.v1"},
    "execution_mode": {"const": "offline_fixture"},
    "experiment_id": {"type": "string", "pattern": "^xstage2exp_[0-9a-f]{24}$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["lab_id", "frozen_from", "frozen_to"],
      "properties": {
        "lab_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "frozen_from": {"type": "string"},
        "frozen_to": {"type": "string"}
      }
    },
    "field_registry": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_version", "registry_sha256"],
      "properties": {
        "registry_version": {"const": "x-stage2-field-registry-v1"},
        "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "normalization_contract_version": {"const": "x.stage2.field_normalization.v1"},
    "source_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_manifest_version", "selection_manifest_sha256", "selection_id", "selected_lead_count", "selected_leads_sha256"],
      "properties": {
        "selection_manifest_version": {"const": "x.stage2.external_selection.fixture.v1"},
        "selection_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_id": {"type": "string", "pattern": "^xstage2selection_[0-9a-f]{24}$"},
        "selected_lead_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "selected_leads_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fixture_scenario_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_version", "scenario_manifest_sha256", "expectation_semantics_sha256", "rows"],
      "properties": {
        "manifest_version": {"const": "stage2-field-capability-fixture-scenarios-v1"},
        "scenario_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expectation_semantics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rows": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/scenario_row"}}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/task"}},
    "technical_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tasks", "max_source_records", "max_canonical_bytes", "max_raw_record_bytes", "max_validation_depth", "max_validation_nodes", "raw_evidence_ttl_seconds"],
      "properties": {
        "max_tasks": {"type": "integer", "const": 10000},
        "max_source_records": {"type": "integer", "const": 100000},
        "max_canonical_bytes": {"type": "integer", "const": 32000000},
        "max_raw_record_bytes": {"type": "integer", "const": 262144},
        "max_validation_depth": {"type": "integer", "const": 64},
        "max_validation_nodes": {"type": "integer", "const": 500000},
        "raw_evidence_ttl_seconds": {"type": "integer", "const": 86400}
      }
    },
    "retention_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_evidence_storage", "retention_scope", "directory_mode", "file_mode", "ttl_seconds", "deletion_receipt_required", "live_reuse_allowed", "promotion_eligible"],
      "properties": {
        "raw_evidence_storage": {"const": "private_owner_only"},
        "retention_scope": {"const": "synthetic_fixture_simulation_only"},
        "directory_mode": {"const": "0700"},
        "file_mode": {"const": "0600"},
        "ttl_seconds": {"type": "integer", "const": 86400},
        "deletion_receipt_required": {"type": "boolean", "const": true},
        "live_reuse_allowed": {"type": "boolean", "const": false},
        "promotion_eligible": {"type": "boolean", "const": false}
      }
    },
    "authority": {"$ref": "#/$defs/request_authority"}
  },
  "$defs": {
    "field_state": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "state"],
      "properties": {
        "field_id": {"type": "string"},
        "state": {"enum": ["present_exact", "present_bounded", "absent", "unverified"]}
      }
    },
    "request_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_or_network_allowed", "model_reported_id_as_identity_allowed", "automatic_identity_merge_allowed", "discovery_or_ranking_allowed", "canonical_write_allowed", "outreach_allowed"],
      "properties": {
        "provider_or_network_allowed": {"type": "boolean", "const": false},
        "model_reported_id_as_identity_allowed": {"type": "boolean", "const": false},
        "automatic_identity_merge_allowed": {"type": "boolean", "const": false},
        "discovery_or_ranking_allowed": {"type": "boolean", "const": false},
        "canonical_write_allowed": {"type": "boolean", "const": false},
        "outreach_allowed": {"type": "boolean", "const": false}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "opaque_lead_ref", "candidate_row_sha256", "lookup_handle", "reported_platform_user_id", "reported_platform_user_id_status", "fixture_scenario_id", "requested_field_ids", "tool_policy", "source_receipt_required", "authority"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^xstage2task_[0-9a-f]{24}$"},
        "opaque_lead_ref": {"type": "string", "pattern": "^xlead_[0-9a-f]{24}$"},
        "candidate_row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lookup_handle": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
        "reported_platform_user_id": {"type": ["string", "null"]},
        "reported_platform_user_id_status": {"enum": ["absent", "model_mediated_unverified"]},
        "fixture_scenario_id": {"enum": ["exact_profile_and_same_account_post", "conflicting_platform_user_ids", "handle_rename_requires_review", "metadata_only_source_payload_unavailable", "post_only_profile_source_unavailable"]},
        "requested_field_ids": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"type": "string"}},
        "tool_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed_tools", "fallback_allowed"],
          "properties": {
            "allowed_tools": {"type": "array", "const": ["x_user_search", "x_thread_fetch"]},
            "fallback_allowed": {"type": "boolean", "const": false}
          }
        },
        "source_receipt_required": {"type": "boolean", "const": true},
        "authority": {"$ref": "#/$defs/request_authority"}
      }
    },
    "scenario_row": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "scenario_id", "expected_terminal_status", "expected_error_codes", "expected_quarantine_reason", "expected_field_states", "expected_profile_count", "expected_post_count", "expected_source_record_kinds"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^xstage2task_[0-9a-f]{24}$"},
        "scenario_id": {"enum": ["exact_profile_and_same_account_post", "conflicting_platform_user_ids", "handle_rename_requires_review", "metadata_only_source_payload_unavailable", "post_only_profile_source_unavailable"]},
        "expected_terminal_status": {"enum": ["completed", "completed_post_only", "quarantined", "failed"]},
        "expected_error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "expected_quarantine_reason": {"type": ["string", "null"]},
        "expected_field_states": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/field_state"}},
        "expected_profile_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "expected_post_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "expected_source_record_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["profile", "post", "tool_metadata_only"]}}
      }
    }
  }
}
