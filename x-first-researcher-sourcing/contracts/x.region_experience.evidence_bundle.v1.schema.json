{
  "$defs": {
    "evidence": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "publisher_actor": {
                "const": "subject_self"
              }
            },
            "required": [
              "publisher_actor"
            ]
          },
          "then": {
            "properties": {
              "actor_subject_relation": {
                "const": "same_external_account"
              },
              "publisher_binding_ref": {
                "type": "null"
              },
              "publisher_binding_status": {
                "const": "self_account_match"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publisher_actor": {
                "const": "verified_organization"
              }
            },
            "required": [
              "publisher_actor"
            ]
          },
          "then": {
            "properties": {
              "actor_subject_relation": {
                "const": "verified_professional_record"
              },
              "publisher_binding_ref": {
                "maxLength": 32,
                "minLength": 32,
                "pattern": "^xbind_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                "type": "string"
              },
              "publisher_binding_status": {
                "const": "verified_organization_binding"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publisher_actor": {
                "const": "third_party"
              }
            },
            "required": [
              "publisher_actor"
            ]
          },
          "then": {
            "properties": {
              "actor_subject_relation": {
                "const": "unrelated_or_unknown"
              },
              "eligibility_status": {
                "enum": [
                  "unresolved",
                  "rejected"
                ]
              },
              "publisher_binding_ref": {
                "type": "null"
              },
              "publisher_binding_status": {
                "const": "unverified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "adjudication_status": {
                "const": "pending"
              }
            },
            "required": [
              "adjudication_status"
            ]
          },
          "then": {
            "properties": {
              "adjudicated_at": {
                "type": "null"
              },
              "adjudication_ref": {
                "type": "null"
              },
              "adjudication_sha256": {
                "type": "null"
              },
              "eligibility_status": {
                "const": "unresolved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "adjudication_status": {
                "const": "adjudicated"
              }
            },
            "required": [
              "adjudication_status"
            ]
          },
          "then": {
            "properties": {
              "adjudicated_at": {
                "format": "date-time",
                "maxLength": 24,
                "minLength": 24,
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:[0-2][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
                "type": "string"
              },
              "adjudication_ref": {
                "maxLength": 31,
                "minLength": 31,
                "pattern": "^xadj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                "type": "string"
              },
              "adjudication_sha256": {
                "maxLength": 64,
                "minLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "eligibility_status": {
                "enum": [
                  "eligible",
                  "rejected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligibility_status": {
                "const": "eligible"
              }
            },
            "required": [
              "eligibility_status"
            ]
          },
          "then": {
            "properties": {
              "publisher_actor": {
                "enum": [
                  "subject_self",
                  "verified_organization"
                ]
              },
              "statement_scope": {
                "const": "subject_explicit_experience"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_medium": {
                "const": "profile_bio"
              }
            },
            "required": [
              "source_medium"
            ]
          },
          "then": {
            "properties": {
              "source_url": {
                "pattern": "^https://(?:(?:www\\.)?x\\.com/[A-Za-z0-9_]{1,15}|(?:(?:[a-z0-9-]+\\.)*(?:openai\\.com|anthropic\\.com|deepmind\\.google|x\\.ai|ai\\.meta\\.com|thinkingmachines\\.ai)|[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.invalid)/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_medium": {
                "enum": [
                  "employment_record",
                  "education_record",
                  "research_record",
                  "post"
                ]
              }
            },
            "required": [
              "source_medium"
            ]
          },
          "then": {
            "properties": {
              "source_url": {
                "pattern": "^https://(?:(?:www\\.)?x\\.com/[A-Za-z0-9_]{1,15}/status/[0-9]{3,32}|(?:(?:[a-z0-9-]+\\.)*(?:openai\\.com|anthropic\\.com|deepmind\\.google|x\\.ai|ai\\.meta\\.com|thinkingmachines\\.ai)|[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.invalid)/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+)$"
              }
            }
          }
        }
      ],
      "properties": {
        "actor_subject_relation": {
          "enum": [
            "same_external_account",
            "verified_professional_record",
            "unrelated_or_unknown"
          ],
          "type": "string"
        },
        "actor_binding_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "adjudicated_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "format": "date-time",
              "maxLength": 24,
              "minLength": 24,
              "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:[0-2][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
              "type": "string"
            }
          ]
        },
        "adjudication_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 31,
              "minLength": 31,
              "pattern": "^xadj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            }
          ]
        },
        "adjudication_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "adjudication_status": {
          "enum": [
            "pending",
            "adjudicated"
          ],
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "content_version": {
          "maxLength": 7,
          "minLength": 7,
          "pattern": "^v[0-9]{6}$",
          "type": "string"
        },
        "eligibility_status": {
          "enum": [
            "unresolved",
            "eligible",
            "rejected"
          ],
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 30,
          "minLength": 30,
          "pattern": "^xev_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 280,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        "excerpt_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "experience_kind": {
          "enum": [
            "based_in",
            "lived_in",
            "worked_in",
            "studied_in",
            "researched_in"
          ],
          "type": "string"
        },
        "extraction_status": {
          "enum": [
            "extracted"
          ],
          "type": "string"
        },
        "location_code": {
          "enum": [
            "asia_unspecified",
            "mainland_china",
            "hong_kong",
            "macau",
            "taiwan",
            "singapore",
            "japan",
            "south_korea",
            "india",
            "unregistered"
          ],
          "type": "string"
        },
        "location_text": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\r\\n\\t]{1,80}$",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "maxLength": 24,
          "minLength": 24,
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:[0-2][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        },
        "proposal_status": {
          "enum": [
            "proposed"
          ],
          "type": "string"
        },
        "publisher_actor": {
          "enum": [
            "subject_self",
            "verified_organization",
            "third_party"
          ],
          "type": "string"
        },
        "publisher_binding_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 32,
              "minLength": 32,
              "pattern": "^xbind_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            }
          ]
        },
        "publisher_binding_status": {
          "enum": [
            "self_account_match",
            "verified_organization_binding",
            "unverified"
          ],
          "type": "string"
        },
        "source_author_platform_user_id": {
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[0-9]{3,32}$",
          "type": "string"
        },
        "source_medium": {
          "enum": [
            "profile_bio",
            "employment_record",
            "education_record",
            "research_record",
            "post"
          ],
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 31,
          "minLength": 31,
          "pattern": "^xsrc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 256,
          "minLength": 10,
          "pattern": "^https://(?:(?:www\\.)?x\\.com/(?:[A-Za-z0-9_]{1,15}|[A-Za-z0-9_]{1,15}/status/[0-9]{3,32})|(?:(?:[a-z0-9-]+\\.)*(?:openai\\.com|anthropic\\.com|deepmind\\.google|x\\.ai|ai\\.meta\\.com|thinkingmachines\\.ai)|[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.invalid)/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+)$",
          "type": "string"
        },
        "statement_scope": {
          "enum": [
            "subject_explicit_experience",
            "location_topic_only",
            "third_party_mention"
          ],
          "type": "string"
        },
        "subject_platform_user_id": {
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[0-9]{3,32}$",
          "type": "string"
        },
        "subject_ref": {
          "maxLength": 31,
          "minLength": 31,
          "pattern": "^pp_x_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_record_id",
        "subject_ref",
        "subject_platform_user_id",
        "source_author_platform_user_id",
        "source_medium",
        "publisher_actor",
        "actor_subject_relation",
        "publisher_binding_status",
        "publisher_binding_ref",
        "actor_binding_sha256",
        "statement_scope",
        "experience_kind",
        "location_code",
        "location_text",
        "source_url",
        "observed_at",
        "content_sha256",
        "content_version",
        "excerpt",
        "excerpt_sha256",
        "extraction_status",
        "proposal_status",
        "adjudication_status",
        "eligibility_status",
        "adjudication_ref",
        "adjudicated_at",
        "adjudication_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://contracts.invalid/x.region_experience.evidence_bundle.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "policy_version": {
      "const": "x-region-experience-public-professional-v1"
    },
    "schema_version": {
      "const": "x.region_experience.evidence_bundle.v1"
    },
    "subject_platform_user_id": {
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]{3,32}$",
      "type": "string"
    },
    "subject_ref": {
      "maxLength": 31,
      "minLength": 31,
      "pattern": "^pp_x_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_version",
    "subject_ref",
    "subject_platform_user_id",
    "evidence"
  ],
  "title": "X-first provider-neutral region-experience evidence bundle v1",
  "type": "object"
}
