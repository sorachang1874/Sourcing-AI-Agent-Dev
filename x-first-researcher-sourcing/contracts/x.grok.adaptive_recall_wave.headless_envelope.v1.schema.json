{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.grok.adaptive_recall_wave.headless_envelope.v1.schema.json",
  "title": "Grok CLI adaptive-wave headless stdout envelope v1",
  "description": "Provider transport envelope. Terminal and usage fields are operator-validated; text contains one result document or the transcript-bound structured progress plus terminal result messages. Provider diagnostics remain non-authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "stopReason", "sessionId", "requestId", "num_turns", "usage"],
  "properties": {
    "text": {"type": "string", "minLength": 1},
    "stopReason": {"const": "EndTurn"},
    "sessionId": {"type": "string", "format": "uuid"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 160},
    "num_turns": {"type": "integer", "minimum": 1},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "modelUsage": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cacheReadInputTokens", "inputTokens", "modelCalls", "outputTokens"],
        "properties": {
          "cacheReadInputTokens": {"type": "integer", "minimum": 0},
          "inputTokens": {"type": "integer", "minimum": 0},
          "modelCalls": {"type": "integer", "minimum": 0},
          "outputTokens": {"type": "integer", "minimum": 0}
        }
      }
    },
    "structuredOutput": {"type": ["object", "null"]},
    "structuredOutputError": {"type": ["string", "null"], "maxLength": 20000},
    "thought": {"type": ["string", "null"]},
    "total_cost_usd": {"type": "number", "minimum": 0}
  }
}
