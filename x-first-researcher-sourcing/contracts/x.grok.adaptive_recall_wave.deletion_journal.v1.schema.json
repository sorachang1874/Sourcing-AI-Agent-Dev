{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.grok.adaptive_recall_wave.deletion_journal.v1.schema.json",
  "title": "Adaptive Grok recall-wave durable deletion journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_sha256",
    "run_lease_sha256",
    "operator_receipt_sha256",
    "delete_after",
    "runtime_root_sha256",
    "created_at",
    "state"
  ],
  "properties": {
    "schema_version": {"const": "x.grok.adaptive_recall_wave.deletion_journal.v1"},
    "run_id": {"type": "string", "pattern": "^grok_wave_(fixture|live)_[0-9a-f]{32}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_lease_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delete_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "runtime_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "state": {"const": "delete_intent_durable"}
  }
}
