{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/x.grok_cli.exploration.query_policy_descriptor.v2.schema.json",
  "title": "Grok CLI public exploration query-policy descriptor v2",
  "description": "Intended-public keyed-commitment descriptor. It contains no query arguments, handles, Bio text, source URLs, commitment key, or nonce. Approval is declared by the reviewed registry and exact descriptor SHA-256; receipt calls are recomputed with the private run-bound key and matched to the ordered HMAC commitments at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "purpose",
    "lab_id",
    "commitment_scheme",
    "commitment_issuance_id",
    "commitment_key_id",
    "commitment_nonce_id",
    "run_binding_commitment",
    "legacy_full_policy_commitment",
    "allowed_decision_dimensions",
    "professional_experience_proxy_query_allowed",
    "protected_identity_query_allowed",
    "protected_category_boundary_version",
    "query_manifest"
  ],
  "properties": {
    "schema_version": {"const": "x.grok_cli.exploration.query_policy_descriptor.v2"},
    "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "purpose": {"const": "base_researcher_discovery"},
    "lab_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "commitment_scheme": {"const": "hmac-sha256-v1"},
    "commitment_issuance_id": {"type": "string", "pattern": "^qci_[0-9a-f]{24}$"},
    "commitment_key_id": {"$ref": "#/$defs/sha256"},
    "commitment_nonce_id": {"$ref": "#/$defs/sha256"},
    "run_binding_commitment": {"$ref": "#/$defs/sha256"},
    "legacy_full_policy_commitment": {"$ref": "#/$defs/sha256"},
    "allowed_decision_dimensions": {
      "type": "array",
      "prefixItems": [
        {"const": "lab_affiliation"},
        {"const": "role_function"},
        {"const": "pretraining_relevance"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "professional_experience_proxy_query_allowed": {"const": false},
    "protected_identity_query_allowed": {"const": false},
    "protected_category_boundary_version": {"const": "base-discovery-protected-category-boundary-v3"},
    "query_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/call_descriptor"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "call_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "tool_name", "call_commitment"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "tool_name": {
          "enum": ["x_keyword_search", "x_semantic_search", "x_user_search", "x_thread_fetch"]
        },
        "call_commitment": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
