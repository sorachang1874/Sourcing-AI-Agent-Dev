VITE_API_BASE_URL=same-origin
VITE_USE_MOCK=false
VITE_USE_LOCAL_ASSETS=false
VITE_ENABLE_EXCEL_INTAKE_WORKFLOW=true
# C2.4: per-user bearer sent as `Authorization: Bearer <token>` to the backend.
# Set to one of the backend's SOURCING_API_BEARER_TOKENS keys when auth is
# enforced server-side; leave empty for an open-mode (no-token) backend.
VITE_SOURCING_API_BEARER_TOKEN=
