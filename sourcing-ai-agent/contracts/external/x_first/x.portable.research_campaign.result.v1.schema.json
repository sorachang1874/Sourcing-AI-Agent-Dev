            "source_bound_evidence_rate",
            "target_direction_core_rate",
            "target_direction_active_rate",
            "evidence_backed_temporal_state_rate",
            "target_core_unique_account_yield_per_native_call",
            "cross_source_handle_resolution_rate"
          ]
        },
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects_total",
        "terminal_subject_outcomes",
