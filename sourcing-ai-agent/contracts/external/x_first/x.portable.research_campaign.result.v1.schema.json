        "origin_task_id",
        "channel_id",
        "relation_kind",
        "temporal_state",
        "matches_temporal_filter",
        "evidence_refs",
        "reason",
        "source_status"
      ],
      "properties": {
        "relationship_id": {"$ref": "#/$defs/identifier"},
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "scope_id": {"$ref": "#/$defs/identifier"},
        "origin_task_id": {"$ref": "#/$defs/identifier"},
