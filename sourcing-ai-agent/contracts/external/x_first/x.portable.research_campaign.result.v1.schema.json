{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.portable.research_campaign.result.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "request_sha256",
    "plan_sha256",
    "catalog_sha256",
    "execution_window",
    "status",
    "subject_outcomes",
    "external_accounts",
    "handle_resolution_evidence",
    "cross_source_link_proposals",
    "discovery_origins",
    "surface_attempts",
    "semantic_recall_attempts",
    "semantic_recall_outcomes",
    "observations",
    "affiliation_results",
    "dimension_results",
    "exploratory_findings",
    "experience_verification_queue",
    "optional_channel_evidence",
    "optional_channel_attempts",
    "optional_channel_outcomes",
    "relationship_results",
    "coverage",
    "limitations",
    "authority",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "x.portable.research_campaign.result.v1"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "execution_window": {"$ref": "#/$defs/execution_window"},
    "status": {"enum": ["complete", "partial", "failed"]},
    "subject_outcomes": {"type": "array", "items": {"$ref": "#/$defs/subject_outcome"}},
    "external_accounts": {"type": "array", "items": {"$ref": "#/$defs/external_account"}},
    "handle_resolution_evidence": {"type": "array", "items": {"$ref": "#/$defs/handle_resolution_evidence"}},
    "cross_source_link_proposals": {"type": "array", "items": {"$ref": "#/$defs/link_proposal"}},
    "discovery_origins": {"type": "array", "items": {"$ref": "#/$defs/discovery_origin"}},
    "surface_attempts": {"type": "array", "items": {"$ref": "#/$defs/surface_attempt"}},
    "semantic_recall_attempts": {"type": "array", "items": {"$ref": "#/$defs/semantic_recall_attempt"}},
    "semantic_recall_outcomes": {"type": "array", "items": {"$ref": "#/$defs/semantic_recall_outcome"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "affiliation_results": {"type": "array", "items": {"$ref": "#/$defs/affiliation_result"}},
    "dimension_results": {"type": "array", "items": {"$ref": "#/$defs/dimension_result"}},
    "exploratory_findings": {"type": "array", "items": {"$ref": "#/$defs/exploratory_finding"}},
    "experience_verification_queue": {"type": "array", "items": {"$ref": "#/$defs/experience_queue_row"}},
    "optional_channel_evidence": {"type": "array", "items": {"$ref": "#/$defs/optional_channel_evidence"}},
    "optional_channel_attempts": {"type": "array", "items": {"$ref": "#/$defs/optional_channel_attempt"}},
    "optional_channel_outcomes": {"type": "array", "items": {"$ref": "#/$defs/optional_channel_outcome"}},
    "relationship_results": {"type": "array", "items": {"$ref": "#/$defs/relationship_result"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "authority": {
      "const": {
        "product_writes_allowed": false,
        "canonical_person_write_allowed": false,
        "automatic_cross_source_merge_allowed": false,
        "outreach_allowed": false
      }
    },
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "source_status": {
      "enum": ["fixture_synthetic", "source_bound", "human_supplied_unverified", "model_mediated_unverified"]
    },
    "execution_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "subject_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_ref", "terminal_state", "x_account_refs", "reason"],
      "properties": {
        "seed_ref": {"$ref": "#/$defs/identifier"},
        "terminal_state": {
          "enum": [
            "analyzed",
            "research_in_progress",
            "handle_resolution_required",
            "no_verified_account",
            "failed"
          ]
        },
        "x_account_refs": {"$ref": "#/$defs/id_array"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "external_account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "platform_user_id",
        "current_handle",
        "profile_url",
        "identity_status",
        "handle_history_proposals"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "platform_user_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{1,32}$"}]
        },
        "current_handle": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
        "profile_url": {"type": "string", "minLength": 1, "maxLength": 512},
        "identity_status": {"enum": ["stable_platform_id", "provisional_handle", "quarantined_handle_reuse"]},
        "handle_history_proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["handle", "first_observed_at", "last_observed_at", "evidence_refs"],
            "properties": {
              "handle": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
              "first_observed_at": {"$ref": "#/$defs/timestamp"},
              "last_observed_at": {"$ref": "#/$defs/timestamp"},
              "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
            }
          }
        }
      }
    },
    "handle_resolution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "seed_ref",
        "x_account_ref",
        "evidence_kind",
        "canonical_url",
        "observed_at",
        "query_text",
        "query_sha256",
        "observed_value",
        "content_sha256",
        "source_status",
        "receipt_ref",
        "retrieval_receipt"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "seed_ref": {"$ref": "#/$defs/identifier"},
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "evidence_kind": {
          "enum": [
            "x_profile_name",
            "x_profile_bio",
            "x_profile_location",
            "x_profile_url",
            "x_profile_professional_category",
            "x_profile_affiliation",
            "professional_fact_overlap"
          ]
        },
        "canonical_url": {"type": "string", "minLength": 1, "maxLength": 512},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "query_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "observed_value": {"type": "string", "minLength": 1, "maxLength": 4000},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_status": {"$ref": "#/$defs/source_status"},
        "receipt_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "retrieval_receipt": {"$ref": "#/$defs/handle_resolution_retrieval_receipt"}
      }
    },
    "handle_resolution_retrieval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "query_sha256",
        "canonical_url",
        "observed_at",
        "content_sha256",
        "source_status",
        "receipt_locator",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "x.handle_resolution.retrieval_receipt.v1"},
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_url": {"type": "string", "minLength": 1, "maxLength": 512},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_status": {"$ref": "#/$defs/source_status"},
        "receipt_locator": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]
        },
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "link_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "seed_ref",
        "x_account_ref",
        "status",
        "evidence_refs",
        "source_status",
        "human_review_required",
        "automatic_merge_authorized"
      ],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/identifier"},
        "seed_ref": {"$ref": "#/$defs/identifier"},
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["proposed", "ambiguous", "conflicted", "rejected"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "source_status": {"$ref": "#/$defs/source_status"},
        "human_review_required": {"const": true},
        "automatic_merge_authorized": {"const": false}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "x_account_ref",
        "surface",
        "platform_object_id",
        "canonical_url",
        "author_platform_user_id",
        "author_handle",
        "published_at",
        "observed_at",
        "text_or_excerpt",
        "content_sha256",
        "source_status",
        "receipt_ref"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/identifier"},
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "surface": {"enum": ["post", "reply"]},
        "platform_object_id": {"type": "string", "pattern": "^[0-9]{1,32}$"},
        "canonical_url": {"type": "string", "minLength": 1, "maxLength": 512},
        "author_platform_user_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{1,32}$"}]
        },
        "author_handle": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
        "published_at": {"$ref": "#/$defs/timestamp"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "text_or_excerpt": {"type": "string", "minLength": 1, "maxLength": 4000},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_status": {"$ref": "#/$defs/source_status"},
        "receipt_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "discovery_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "origin_task_id",
        "channel_id",
        "evidence_refs",
        "source_status",
        "requires_candidate_authored_followup"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "origin_task_id": {"$ref": "#/$defs/identifier"},
        "channel_id": {"enum": ["project_direct_credit", "official_source", "conversation_graph"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "source_status": {"$ref": "#/$defs/source_status"},
        "requires_candidate_authored_followup": {"const": true}
      }
    },
    "surface_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "surface",
        "ordinal",
        "query_text",
        "query_sha256",
        "receipt_ref",
        "source_status",
        "execution_state",
        "bound_observation_count",
        "result_truncated",
        "continuation_state",
        "input_continuation_ref",
        "continuation_ref"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "surface": {"enum": ["post", "reply"]},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "query_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_status": {"enum": ["fixture_synthetic", "receipt_bound", "unverified"]},
        "execution_state": {"enum": ["completed", "no_result", "failed"]},
        "bound_observation_count": {"type": "integer", "minimum": 0},
        "result_truncated": {"type": "boolean"},
        "continuation_state": {"enum": ["exhausted", "continuation_available", "unknown"]},
        "input_continuation_ref": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]
        },
        "continuation_ref": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]
        }
      }
    },
    "semantic_recall_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "question_id",
        "label_id",
        "ordinal",
        "page_ordinal",
        "surface",
        "query_text",
        "query_sha256",
        "receipt_ref",
        "source_status",
        "execution_state",
        "bound_observation_count",
        "result_truncated",
        "continuation_state",
        "input_continuation_ref",
        "continuation_ref",
        "new_unique_observation_refs",
        "new_target_evidence_refs"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "question_id": {"$ref": "#/$defs/identifier"},
        "label_id": {"$ref": "#/$defs/identifier"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "page_ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "surface": {"enum": ["post", "reply"]},
        "query_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_status": {"enum": ["fixture_synthetic", "receipt_bound", "unverified"]},
        "execution_state": {"enum": ["completed", "no_result", "failed"]},
        "bound_observation_count": {"type": "integer", "minimum": 0},
        "result_truncated": {"type": "boolean"},
        "continuation_state": {"enum": ["exhausted", "continuation_available", "unknown"]},
        "input_continuation_ref": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]
        },
        "continuation_ref": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]
        },
        "new_unique_observation_refs": {"$ref": "#/$defs/id_array"},
        "new_target_evidence_refs": {"$ref": "#/$defs/id_array"}
      }
    },
    "semantic_recall_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "question_id",
        "execution_policy",
        "terminal_state",
        "attempted_query_sha256s",
        "stop_reason",
        "receipt_refs",
        "adaptive_stop_decision"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "question_id": {"$ref": "#/$defs/identifier"},
        "execution_policy": {
          "enum": ["authored_surface_only", "adaptive_marginal_gain", "exhaustive_alias_matrix"]
        },
        "terminal_state": {
          "enum": [
            "authored_surface_complete",
            "adaptive_complete",
            "target_match_proven",
            "exhaustive_complete",
            "not_run",
            "failed"
          ]
        },
        "attempted_query_sha256s": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"}
        },
        "stop_reason": {
          "enum": [
            "broad_authored_surface_completed",
            "marginal_gain_sustained_low",
            "configured_target_match_proven",
            "alias_matrix_exhausted",
            "not_run",
            "execution_failed"
          ]
        },
        "receipt_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "adaptive_stop_decision": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/adaptive_stop_decision"}]
        }
      }
    },
    "adaptive_stop_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_size",
        "window_query_sha256s",
        "observed_new_unique_observation_count",
        "observed_new_target_evidence_count",
        "configured_maximum_new_target_evidence",
        "remaining_query_sha256s",
        "scope_frontier_audit",
        "scope_frontier_audit_ref",
        "source_status",
        "decision_sha256"
      ],
      "properties": {
        "window_size": {"type": "integer", "minimum": 2, "maximum": 100},
        "window_query_sha256s": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "observed_new_unique_observation_count": {"type": "integer", "minimum": 0},
        "observed_new_target_evidence_count": {"type": "integer", "minimum": 0},
        "configured_maximum_new_target_evidence": {"type": "integer", "minimum": 0},
        "remaining_query_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "scope_frontier_audit": {"$ref": "#/$defs/scope_frontier_audit"},
        "scope_frontier_audit_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_status": {"enum": ["fixture_synthetic", "receipt_bound", "unverified"]},
        "decision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope_frontier_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "x_account_ref",
        "question_id",
        "covered_label_surface_pairs",
        "attempted_query_sha256s",
        "remaining_query_sha256s",
        "audit_status",
        "source_status",
        "audit_sha256"
      ],
      "properties": {
        "schema_version": {"const": "x.semantic_recall.scope_frontier_audit.v1"},
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "question_id": {"$ref": "#/$defs/identifier"},
        "covered_label_surface_pairs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label_id", "surface"],
            "properties": {
              "label_id": {"$ref": "#/$defs/identifier"},
              "surface": {"enum": ["post", "reply"]}
            }
          }
        },
        "attempted_query_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "remaining_query_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "audit_status": {"const": "negative_stop_frontier_audited"},
        "source_status": {"enum": ["fixture_synthetic", "receipt_bound", "unverified"]},
        "audit_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "affiliation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "scope_id",
        "temporal_state",
        "matches_temporal_filter",
        "evidence_refs",
        "reason",
        "source_status"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "scope_id": {"$ref": "#/$defs/identifier"},
        "temporal_state": {"enum": ["current", "historical", "ambiguous", "unsupported"]},
        "matches_temporal_filter": {"type": "boolean"},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_status": {"$ref": "#/$defs/source_status"}
      }
    },
    "dimension_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "question_id",
        "dimension_id",
        "matched_label_ids",
        "relevance_state",
        "target_activity_temporal_state",
        "matches_temporal_filter",
        "evidence_refs",
        "reason",
        "source_status"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "question_id": {"$ref": "#/$defs/identifier"},
        "dimension_id": {"$ref": "#/$defs/identifier"},
        "matched_label_ids": {"$ref": "#/$defs/id_array"},
        "relevance_state": {"enum": ["target_core", "target_adjacent", "ambiguous", "out_of_scope"]},
        "target_activity_temporal_state": {
          "enum": ["current", "historical", "ambiguous", "unsupported", "not_applicable"]
        },
        "matches_temporal_filter": {"type": "boolean"},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_status": {"$ref": "#/$defs/source_status"}
      }
    },
    "exploratory_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "x_account_ref", "question_id", "proposed_label", "evidence_refs", "reason", "source_status"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/identifier"},
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "question_id": {"$ref": "#/$defs/identifier"},
        "proposed_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_status": {"$ref": "#/$defs/source_status"}
      }
    },
    "experience_queue_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_account_ref",
        "dimension_id",
        "status",
        "evidence_refs",
        "reason",
        "source_status",
        "identity_inference_performed"
      ],
      "properties": {
        "x_account_ref": {"$ref": "#/$defs/identifier"},
        "dimension_id": {"const": "china_asia_professional_educational_experience"},
