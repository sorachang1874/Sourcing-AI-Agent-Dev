        "continuation_ref": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "optional_channel_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "channel_id",
        "terminal_state",
        "attempt_ids",
        "evidence_refs",
        "reason",
        "source_status"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"},
