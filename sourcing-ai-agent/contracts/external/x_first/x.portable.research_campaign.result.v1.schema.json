      "properties": {
        "subjects_total": {"type": "integer", "minimum": 0},
        "terminal_subject_outcomes": {"type": "integer", "minimum": 0},
        "resolved_account_count": {"type": "integer", "minimum": 0},
        "candidate_authored_post_attempted": {"type": "integer", "minimum": 0},
        "candidate_authored_reply_attempted": {"type": "integer", "minimum": 0},
        "candidate_authored_both_surface_attempted": {"type": "integer", "minimum": 0},
        "observation_count": {"type": "integer", "minimum": 0},
        "coverage_source_status": {"enum": ["fixture_synthetic", "receipt_bound", "unverified"]},
        "metric_values": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/metric_value"}}
      }
