{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcing-ai-agent.invalid/contracts/x.portable.research_campaign.request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "as_of",
    "scope_selection",
    "analysis_questions",
    "temporal_scope",
    "channel_overrides",
    "seed_inputs",
    "experience_verification",
    "authority",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {"const": "x.portable.research_campaign.request.v1"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "as_of": {"$ref": "#/$defs/timestamp"},
    "scope_selection": {"$ref": "#/$defs/scope_selection"},
    "analysis_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    },
    "temporal_scope": {"$ref": "#/$defs/temporal_scope"},
    "channel_overrides": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "enabled"],
        "properties": {
          "channel_id": {
            "enum": ["candidate_authored_surface", "project_direct_credit", "official_source", "conversation_graph"]
          },
          "enabled": {"type": "boolean"}
        }
      }
    },
    "seed_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/seed_input"}
    },
    "experience_verification": {"$ref": "#/$defs/experience_verification"},
    "authority": {
      "const": {
        "provider_calls_allowed": false,
        "product_writes_allowed": false,
        "canonical_person_merge_allowed": false,
        "outreach_allowed": false
      }
    },
    "request_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "nullable_text": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 512}
      ]
    },
    "scope_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_mode", "root_scope_ids", "selected_scope_ids", "required_fresh_scope_kinds"],
      "properties": {
        "selection_mode": {"enum": ["complete_under_roots", "explicit_nodes"]},
        "root_scope_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "selected_scope_ids": {"$ref": "#/$defs/id_array"},
        "required_fresh_scope_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "organization",
              "model",
              "product",
              "application",
              "research_program",
              "capability",
              "industry",
              "team",
              "initiative"
            ]
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "analysis_mode",
        "question_text",
        "dimension_id",
        "target_label_ids",
        "target_match_operator",
        "recall_execution_policy",
        "adaptive_stop_policy"
      ],
      "properties": {
        "question_id": {"$ref": "#/$defs/identifier"},
        "analysis_mode": {"enum": ["exploratory", "verification", "hybrid"]},
        "question_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "dimension_id": {"$ref": "#/$defs/identifier"},
        "target_label_ids": {"$ref": "#/$defs/id_array"},
        "target_match_operator": {"enum": ["not_applicable", "any", "all"]},
        "recall_execution_policy": {
          "enum": ["authored_surface_only", "adaptive_marginal_gain", "exhaustive_alias_matrix"]
        },
        "adaptive_stop_policy": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/adaptive_stop_policy"}]
        }
      }
    },
    "adaptive_stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_size",
        "minimum_attempts_per_surface",
        "maximum_new_target_evidence_in_window",
        "scope_frontier_audit_required"
      ],
      "properties": {
        "window_size": {"type": "integer", "minimum": 2, "maximum": 100},
        "minimum_attempts_per_surface": {"type": "integer", "minimum": 1, "maximum": 50},
        "maximum_new_target_evidence_in_window": {"type": "integer", "minimum": 0, "maximum": 10000},
        "scope_frontier_audit_required": {"const": true}
      }
    },
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affiliation_states", "target_activity_states"],
      "properties": {
        "affiliation_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["current", "historical", "ambiguous", "unsupported"]}
        },
        "target_activity_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["current", "historical", "ambiguous", "unsupported"]}
        }
      }
    },
    "seed_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_ref",
        "source_kind",
        "external_record_ref",
        "source_record_sha256",
        "source_status",
        "source_profile_url",
        "name_text",
        "x_handle_proposals",
        "professional_facts"
      ],
      "properties": {
        "seed_ref": {"$ref": "#/$defs/identifier"},
        "source_kind": {
          "enum": ["x_account", "linkedin_profile", "professional_profile", "name_only"]
        },
        "external_record_ref": {"$ref": "#/$defs/nullable_text"},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_status": {
          "enum": ["fixture_synthetic", "source_bound", "human_supplied_unverified", "model_mediated_unverified"]
        },
        "source_profile_url": {"$ref": "#/$defs/nullable_text"},
        "name_text": {"$ref": "#/$defs/nullable_text"},
        "x_handle_proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["handle", "binding_status", "evidence_ref"],
            "properties": {
              "handle": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
              "binding_status": {"enum": ["source_asserted", "cross_source_link_proposed"]},
              "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        },
        "professional_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_type", "value", "temporal_state", "evidence_ref"],
            "properties": {
              "fact_type": {
                "enum": ["affiliation", "role", "education", "project", "location", "other"]
              },
              "value": {"type": "string", "minLength": 1, "maxLength": 1000},
              "temporal_state": {"enum": ["current", "historical", "ambiguous", "not_applicable"]},
              "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      }
    },
    "experience_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trigger", "dimension_ids"],
      "properties": {
        "enabled": {"type": "boolean"},
        "trigger": {"enum": ["not_requested", "explicit_query_request"]},
        "dimension_ids": {"$ref": "#/$defs/id_array"}
      }
    }
  }
}
